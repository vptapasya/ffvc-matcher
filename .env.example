# FFVC Job Matcher — Environment Variables
# Paste these into Vercel → Project → Settings → Environment Variables

ANTHROPIC_API_KEY=sk-ant-...

GOOGLE_SHEET_ID=1BxiMVs0XRA5nFMdKvBdBZjgmUUqptlbs74OgVE2upms

# From your Google Cloud service account JSON:
GOOGLE_SERVICE_ACCOUNT_EMAIL=ffvc-matcher@your-project.iam.gserviceaccount.com

# The private key — paste the FULL key including -----BEGIN/END----- lines
# Vercel stores newlines as \n automatically when you paste multi-line values
GOOGLE_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\nMIIE...\n-----END RSA PRIVATE KEY-----
